# Browser build. Leave empty in a same-origin full-stack production build.
# GitHub Pages automatically remains local-first because it has no backend runtime.
VITE_AGRISMART_API_URL=http://localhost:3000
VITE_AGRISMART_CHAT_URL=http://localhost:3000

# Node mission API
PORT=3000
AGRISMART_ALLOWED_ORIGIN=http://localhost:3000
AGRISMART_OPERATOR_TOKEN=replace-with-a-long-random-secret

# Companion-computer or mission-controller bridge.
# The bridge must expose POST /missions and POST /control/step.
AGRISMART_AUTOPILOT_BRIDGE_URL=http://localhost:8081
AGRISMART_BRIDGE_TOKEN=replace-with-a-separate-bridge-secret

# Optional OpenAI-compatible or internal chat-completions endpoint.
# Keep the API key on the server. Never put it in a VITE_ variable.
AGRISMART_LLM_URL=
AGRISMART_LLM_API_KEY=
AGRISMART_LLM_MODEL=agrismart-assistant

# Optional OpenAI-compatible multimodal crop-vision endpoint.
# When omitted, AgriSmart uses a cautious local image-metrics and context fallback.
AGRISMART_VISION_URL=
AGRISMART_VISION_API_KEY=
AGRISMART_VISION_MODEL=agrismart-crop-vision
