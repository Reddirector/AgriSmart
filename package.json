{
  "name": "agrismart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "npm run check",
    "check": "tsc --noEmit",
    "build:strict": "tsc --noEmit && vite build",
    "deploy:check": "npm run check && npm run build",
    "start": "node server/index.mjs",
    "serve:full": "node server/index.mjs",
    "verify:production": "npm run check && npm run verify:ui && npm run verify:claims && npm run verify:crop-health && npm run build && node scripts/verify-build.mjs",
    "verify:claims": "node scripts/verify-claims.mjs",
    "verify:crop-health": "node scripts/verify-crop-health.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.412.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.25.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
